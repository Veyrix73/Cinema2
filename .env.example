# Copy this file to .env for local development.
# Use a PostgreSQL database URL from your hosting provider.
DATABASE_URL=postgresql://postgres:password@localhost:5432/dancing_fruit_cinema
# Generate a long random value (at least 32 characters).
SESSION_SECRET=replace-with-a-long-random-secret
